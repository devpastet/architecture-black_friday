"p5-consul1" value="consul-server-1&lt;br&gt;&lt;font style='font-size:10px'&gt;:8500 / :8300&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="610" width="130" height="50" as="geometry"/></mxCell><mxCell id="p5-consul2" value="consul-server-2&lt;br&gt;&lt;font style='font-size:10px'&gt;:8500 / :8300&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1200" y="610" width="130" height="50" as="geometry"/></mxCell><mxCell id="p5-consul3" value="consul-server-3&lt;br&gt;&lt;font style='font-size:10px'&gt;:8500 / :8300&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1350" y="610" width="130" height="50" as="geometry"/></mxCell><mxCell id="p5-e9" value="raft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;" edge="1" parent="1" source="p5-consul1" target="p5-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e10" value="raft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;" edge="1" parent="1" source="p5-consul2" target="p5-consul3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-cnote" value="&lt;i&gt;Фиолетовый пунктир от инстансов pymongo_api&lt;/i&gt; — регистрация в Consul. Каждый инстанс pymongo_api регистрируется в Consul (consul-agent / registrator) с health-check GET / . API Gateway (Traefik / Nginx + consul-template) читает из Consul список здоровых инстансов сервиса &lt;b&gt;pymongo-api&lt;/b&gt; и сам добавляет/убирает их из балансировки." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="750" width="450" height="120" as="geometry"/></mxCell><mxCell id="p5-e12" value="service discovery&lt;br&gt;(список здоровых инстансов)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;" edge="1" parent="1" source="p5-gw" target="p5-consul1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e13" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-gw" target="p5-app1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;exitX=0.85;exitY=0;entryY=1;" edge="1" parent="1" source="p5-app1" target="p5-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e15" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-gw" target="p5-app2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;exitX=0.85;exitY=0;entryY=1;" edge="1" parent="1" source="p5-app2" target="p5-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e17" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-gw" target="p5-app3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;exitX=0.85;exitY=0;entryY=1;" edge="1" parent="1" source="p5-app3" target="p5-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-ugrp" value="Пользователи в разных регионах" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="50" width="1080" height="150" as="geometry"/></mxCell><mxCell id="p5-cdngrp" value="CDN (edge-серверы в регионах)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="1080" height="170" as="geometry"/></mxCell><mxCell id="p5-u_msk" value="Пользователь&lt;br&gt;(Москва)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="285" y="80" width="30" height="60" as="geometry"/></mxCell><mxCell id="p5-cdn_msk" value="CDN edge&lt;br&gt;Москва&lt;br&gt;&lt;font style='font-size:10px'&gt;кеш статики&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1"><mxGeometry x="220" y="270" width="160" height="100" as="geometry"/></mxCell><mxCell id="p5-e23" value="HTTPS&lt;br&gt;(GeoDNS → ближайший edge)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#10739e;" edge="1" parent="1" source="p5-u_msk" target="p5-cdn_msk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-u_nsk" value="Пользователь&lt;br&gt;(Новосибирск)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="655" y="80" width="30" height="60" as="geometry"/></mxCell><mxCell id="p5-cdn_nsk" value="CDN edge&lt;br&gt;Новосибирск&lt;br&gt;&lt;font style='font-size:10px'&gt;кеш статики&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1"><mxGeometry x="590" y="270" width="160" height="100" as="geometry"/></mxCell><mxCell id="p5-e26" value="HTTPS&lt;br&gt;(GeoDNS → ближайший edge)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#10739e;" edge="1" parent="1" source="p5-u_nsk" target="p5-cdn_nsk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-u_vvo" value="Пользователь&lt;br&gt;(Владивосток)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1025" y="80" width="30" height="60" as="geometry"/></mxCell><mxCell id="p5-cdn_vvo" value="CDN edge&lt;br&gt;Владивосток&lt;br&gt;&lt;font style='font-size:10px'&gt;кеш статики&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1"><mxGeometry x="960" y="270" width="160" height="100" as="geometry"/></mxCell><mxCell id="p5-e29" value="HTTPS&lt;br&gt;(GeoDNS → ближайший edge)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#10739e;" edge="1" parent="1" source="p5-u_vvo" target="p5-cdn_vvo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-s3" value="Static origin&lt;br&gt;Object Storage (S3)&lt;br&gt;&lt;font style='font-size:10px'&gt;JS, CSS, картинки товаров&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300" y="430" width="180" height="90" as="geometry"/></mxCell><mxCell id="p5-cdnnote" value="&lt;b&gt;Статика&lt;/b&gt; (JS/CSS/картинки) отдаётся из кеша ближайшего edge-сервера. При промахе кеша edge забирает файл из Static origin (S3) и кеширует его по TTL. &lt;b&gt;Динамика&lt;/b&gt; (/api, JSON) не кешируется и проксируется edge-сервером на API Gateway." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="50" width="310" height="130" as="geometry"/></mxCell><mxCell id="p5-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#10739e;exitX=0.7;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-cdn_msk" target="p5-s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.4;exitY=0.95;entryY=0;" edge="1" parent="1" source="p5-cdn_msk" target="p5-gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#10739e;exitX=0.7;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-cdn_nsk" target="p5-s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e35" value="динамика (/api), без кеша" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.4;exitY=0.95;entryY=0;" edge="1" parent="1" source="p5-cdn_nsk" target="p5-gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e36" value="static (cache miss)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#10739e;exitX=0.7;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5-cdn_vvo" target="p5-s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.4;exitY=0.95;entryY=0;" edge="1" parent="1" source="p5-cdn_vvo" target="p5-gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-ci" value="CI/CD&lt;br&gt;&lt;font style='font-size:10px'&gt;деплой фронтенда&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1320" y="260" width="140" height="50" as="geometry"/></mxCell><mxCell id="p5-e39" value="загрузка статики" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-ci" target="p5-s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-mongos" value="mongos_router&lt;br&gt;&lt;font style='font-size:10px'&gt;mongos :27020&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSty