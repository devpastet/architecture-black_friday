=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="230" width="130" height="50" as="geometry"/></mxCell><mxCell id="p4-consul2" value="consul-server-2&lt;br&gt;&lt;font style='font-size:10px'&gt;:8500 / :8300&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1200" y="230" width="130" height="50" as="geometry"/></mxCell><mxCell id="p4-consul3" value="consul-server-3&lt;br&gt;&lt;font style='font-size:10px'&gt;:8500 / :8300&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1350" y="230" width="130" height="50" as="geometry"/></mxCell><mxCell id="p4-e9" value="raft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;" edge="1" parent="1" source="p4-consul1" target="p4-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e10" value="raft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;" edge="1" parent="1" source="p4-consul2" target="p4-consul3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-cnote" value="&lt;i&gt;Фиолетовый пунктир от инстансов pymongo_api&lt;/i&gt; — регистрация в Consul. Каждый инстанс pymongo_api регистрируется в Consul (consul-agent / registrator) с health-check GET / . API Gateway (Traefik / Nginx + consul-template) читает из Consul список здоровых инстансов сервиса &lt;b&gt;pymongo-api&lt;/b&gt; и сам добавляет/убирает их из балансировки." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="370" width="450" height="120" as="geometry"/></mxCell><mxCell id="p4-e12" value="service discovery&lt;br&gt;(список здоровых инстансов)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;" edge="1" parent="1" source="p4-gw" target="p4-consul1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e13" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p4-gw" target="p4-app1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;exitX=0.85;exitY=0;entryY=1;" edge="1" parent="1" source="p4-app1" target="p4-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e15" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p4-gw" target="p4-app2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;exitX=0.85;exitY=0;entryY=1;" edge="1" parent="1" source="p4-app2" target="p4-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e17" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p4-gw" target="p4-app3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9673a6;exitX=0.85;exitY=0;entryY=1;" edge="1" parent="1" source="p4-app3" target="p4-consul2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-user" value="Пользователь&lt;br&gt;(браузер)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="635" y="100" width="30" height="60" as="geometry"/></mxCell><mxCell id="p4-e20" value="HTTPS :443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p4-user" target="p4-gw"><mxGeometry relative="1" as="geometry"/></mxCell>